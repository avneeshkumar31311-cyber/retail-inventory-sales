    {
      "name": "06 - Admin Creates Test Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Product\",\n  \"sku\": \"{{testProductSku}}\",\n  \"category\": \"Postman Tests\",\n  \"purchasePrice\": 50,\n  \"sellingPrice\": 100,\n  \"price\": 100,\n  \"quantity\": 2,\n  \"lowStockThreshold\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"testProductSku\", \"PM-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
              "const payload = pm.response.json();",
              "const data = payload.data || payload;",
              "const id = data._id || (data.product && data.product._id);",
              "pm.test(\"Product ID returned\", function () { pm.expect(id).to.be.a(\"string\").and.not.empty; });",
              "pm.environment.set(\"productId\", id);"
            ]
          }
        }
      ]
    },
