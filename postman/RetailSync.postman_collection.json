    {
      "name": "10 - Admin Creates Discounted Sale",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/sales",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"product\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"discountPercent\": 10,\n  \"taxPercent\": 18\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
              "const payload = pm.response.json();",
              "const data = payload.data || payload;",
              "pm.test(\"Invoice number returned\", function () { pm.expect(data.invoiceNumber).to.be.a(\"string\").and.not.empty; });",
              "pm.test(\"Total, discount and tax returned\", function () {",
              "  pm.expect(data.totalAmount).to.be.a(\"number\");",
              "  pm.expect(data.discountAmount).to.be.a(\"number\");",
              "  pm.expect(data.taxAmount).to.be.a(\"number\");",
              "});",
              "pm.environment.set(\"saleId\", data._id);"
            ]
          }
        }
      ]
    },
