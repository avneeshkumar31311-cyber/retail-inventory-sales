          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "const payload = pm.response.json();",
              "const sale = payload.data || payload;",
              "pm.test(\"Invoice total is numeric\", function () { pm.expect(sale.totalAmount).to.be.a(\"number\"); });",
              "pm.test(\"Invoice breakdown is present\", function () {",
              "  pm.expect(sale.subtotal).to.be.a(\"number\");",
              "  pm.expect(sale.discountAmount).to.be.a(\"number\");",
              "  pm.expect(sale.taxAmount).to.be.a(\"number\");",
              "});"
            ]
          }
        }
