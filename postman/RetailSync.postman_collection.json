  "info": {
    "_postman_id": "c3f0e909-4983-4a8c-9f94-6c4a6d2f1101",
    "name": "RetailSync API Tests",
    "description": "Sequential API checks for RetailSync authentication, product management, invoices, stock movement, authorization and reports. It creates test records in the connected database; use a development database.",
