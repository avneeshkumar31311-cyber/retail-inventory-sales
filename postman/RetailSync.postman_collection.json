    {
      "name": "14 - Date Range Sales Report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/reports/sales?from={{reportFrom}}&to={{reportTo}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const to = new Date();",
              "const from = new Date();",
              "from.setUTCDate(from.getUTCDate() - 30);",
              "pm.environment.set(\"reportFrom\", from.toISOString().slice(0, 10));",
              "pm.environment.set(\"reportTo\", to.toISOString().slice(0, 10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
